# ═══════════════════════════════════════════════════════════════
# TalentOS — Variables de Entorno
# Copia este archivo como .env y llena los valores reales
# NUNCA subas el .env real a Git
# ═══════════════════════════════════════════════════════════════

# ─── JWT ────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_una_clave_segura_minimo_32_caracteres
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# ─── AUTH DB (PostgreSQL) ───────────────────────────────────────
AUTH_DB_HOST=auth-db
AUTH_DB_PORT=5432
AUTH_DB_NAME=talentos_auth
AUTH_DB_USER=postgres
AUTH_DB_PASSWORD=cambia_esta_password

# ─── EMPLOYEE DB (PostgreSQL) ───────────────────────────────────
EMPLOYEE_DB_HOST=employee-db
EMPLOYEE_DB_PORT=5432
EMPLOYEE_DB_NAME=talentos_employee
EMPLOYEE_DB_USER=postgres
EMPLOYEE_DB_PASSWORD=cambia_esta_password

# ─── PAYROLL DB (MySQL) ─────────────────────────────────────────
PAYROLL_DB_HOST=payroll-db
PAYROLL_DB_PORT=3306
PAYROLL_DB_NAME=talentos_payroll
PAYROLL_DB_USER=payroll_user
PAYROLL_DB_PASSWORD=cambia_esta_password
PAYROLL_DB_ROOT_PASSWORD=cambia_root_password

# ─── TRAINING DB (PostgreSQL) ───────────────────────────────────
TRAINING_DB_HOST=training-db
TRAINING_DB_PORT=5432
TRAINING_DB_NAME=talentos_training
TRAINING_DB_USER=postgres
TRAINING_DB_PASSWORD=cambia_esta_password

# ─── URLs INTERNAS (no cambiar — son nombres Docker) ────────────
AUTH_SERVICE_URL=http://auth-service:3001
EMPLOYEE_SERVICE_URL=http://employee-service:8080
PAYROLL_SERVICE_URL=http://payroll-service:9000
TRAINING_SERVICE_URL=http://training-service:3002

# ─── PUERTOS EXTERNOS (para acceso desde tu máquina) ────────────
FRONTEND_PORT=5173
GATEWAY_PORT=3000
AUTH_PORT=3001
EMPLOYEE_PORT=8080
PAYROLL_PORT=9000
TRAINING_PORT=3002

# ─── CORREO (SMTP) ──────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo@gmail.com
SMTP_PASS=app_password_aqui
SMTP_FROM=TalentOS <correo@gmail.com>

# ─── FRONTEND ───────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_APP_NAME=TalentOS
